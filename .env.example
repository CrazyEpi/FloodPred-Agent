DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY_HERE
# Optional bounded public web search; registered URLs also work without it. Not the DeepSeek key. No provider account is required for offline tests.
BRAVE_SEARCH_API_KEY=<YOUR_BRAVE_SEARCH_API_KEY>
# Optional chat settings. No new environment or provider account is needed.
FLOODPRED_CHAT_CONTEXT_BUDGET=65536
FLOODPRED_CHAT_PLAN_MAX_TOKENS=4096
